{
  "sourceRoots": ["src"],
  "extensions": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"],
  "excludeSuffixes": [
    ".test.ts",
    ".test.tsx",
    ".test.js",
    ".test.jsx",
    ".test.mjs",
    ".test.cjs",
    ".test.mts",
    ".test.cts",
    ".e2e.ts",
    ".e2e.tsx",
    ".e2e.js",
    ".e2e.jsx",
    ".e2e.mjs",
    ".e2e.cjs",
    ".e2e.mts",
    ".e2e.cts",
    ".d.ts",
    ".d.mts",
    ".d.cts"
  ],
  "maxFileLines": 1000,
  "maxDirectoryFiles": 40,
  "fileExceptions": {},
  "directoryExceptions": {}
}
